# Anthropic Claude API key — get from console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Gong webhook HMAC secret — set when registering the webhook in Gong
GONG_WEBHOOK_SECRET=your_secret_here

# Guusto credentials — get from Guusto workspace admin or your Guusto contact
# Use api-demo.guusto.io values for hackathon POC
GUUSTO_BEARER_TOKEN=your_token_here
GUUSTO_WORKSPACE_ID=your_workspace_id_here

# Server port
PORT=3001
